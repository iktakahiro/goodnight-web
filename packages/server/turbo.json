{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "admin-ui/dist/**",
        "src/features/admin-ui/admin-files.gen.ts"
      ]
    },
    "type-check": {
      "dependsOn": ["^type-check", "build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test", "build"],
      "outputs": []
    }
  }
}
