// Test Worker for the end-to-end test (bun run test:e2e) and for
// `deploy:check`. Local only: it is never deployed.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "goodnight-web-server-e2e",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodnight-web-server-e2e",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    // Cloudflare's public Turnstile test site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
}
