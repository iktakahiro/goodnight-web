{
  "name": "@goodnight-web/server",
  "version": "0.9.2",
  "description": "Worker factory, contact API, passkey admin auth, admin API, and D1 migrations for goodnight-web sites.",
  "keywords": [
    "astro",
    "cloudflare",
    "contact-form",
    "d1",
    "hono",
    "passkey",
    "workers"
  ],
  "homepage": "https://goodnight-web.dev",
  "bugs": {
    "url": "https://github.com/iktakahiro/goodnight-web/issues"
  },
  "license": "MIT",
  "author": "Takahiro Ikeuchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iktakahiro/goodnight-web.git",
    "directory": "packages/server"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "migrations",
    "!migrations/meta",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contact": "./src/contact.ts",
    "./client": "./src/client.ts",
    "./messages": "./src/messages.ts",
    "./admin-messages.json": "./src/features/admin-ui/admin-messages.gen.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config admin-ui/vite.config.ts && bun scripts/build-admin-module.ts && bun scripts/build-admin-messages.ts",
    "prepack": "bun run build",
    "type-check": "tsc -p tsconfig.json && tsc -p admin-ui/tsconfig.json",
    "test": "bun test src admin-ui/src",
    "test:e2e": "bun e2e/run.ts",
    "deploy:check": "wrangler deploy --dry-run -c e2e/wrangler.jsonc --outdir dist/dry-run",
    "screenshots": "bun e2e/screenshots.ts",
    "screenshots:docs": "bun e2e/docs-screenshots.ts",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --yes --output",
    "db:check": "bun scripts/check-migrations.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "nanostores": "1.5.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "@goodnight-web/typescript-config": "workspace:*",
    "@gravity-ui/icons": "2.23.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.3"
  }
}
