{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".bun-version", "bunfig.toml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "deploy:check": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
