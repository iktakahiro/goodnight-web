{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".bun-version", "bunfig.toml"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "deploy:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@goodnight-web/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["DOCS_BASE_PATH", "DOCS_SITE_URL"]
    },
    "@goodnight-web/docs#dev": {
      "cache": false,
      "persistent": true,
      "env": ["DOCS_BASE_PATH", "DOCS_SITE_URL"]
    },
    "@goodnight-web/docs#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DOCS_BASE_PATH", "DOCS_SITE_URL"]
    }
  }
}
