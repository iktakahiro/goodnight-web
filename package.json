{
  "name": "goodnight-web-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "bun --bun oxlint .",
    "lint:fix": "bun --bun oxlint --fix .",
    "format": "bun --bun oxfmt --check .",
    "format:fix": "bun --bun oxfmt .",
    "type-check": "turbo run type-check && tsc -p tsconfig.json",
    "test": "turbo run test && bun test ./templates/starter/.github/scripts",
    "check:sql": "bun test ./scripts && bun scripts/check-sql.ts",
    "check:release": "bun scripts/check-release.ts",
    "db:generate": "bun run --cwd packages/server db:generate",
    "db:check": "bun run --cwd packages/server db:check",
    "validate": "bun run lint && bun run format && bun run type-check && bun run check:sql && bun run db:check && bun run check:release && bun run test",
    "fix": "bun run lint:fix && bun run format:fix",
    "deploy:check": "turbo run deploy:check",
    "brand:build": "bun brand/scripts/build.ts"
  },
  "devDependencies": {
    "@goodnight-web/typescript-config": "workspace:*",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.4"
}
