{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goodnight-web-docs",
  "compatibility_date": "2026-10-19",
  // A static-assets-only Worker: there is no `main` script, so no code runs
  // for any request.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  // The docs live on the apex domain only. `custom_domain: true` makes
  // Cloudflare create the DNS record and the certificate on deploy, so the
  // zone must be on the same Cloudflare account. Build with
  // DOCS_SITE_URL=https://goodnight-web.dev (the default) so the canonical and
  // hreflang URLs match this route.
  "routes": [{ "pattern": "goodnight-web.dev", "custom_domain": true }],
}
