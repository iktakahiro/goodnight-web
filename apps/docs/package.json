{
  "name": "@goodnight-web/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun scripts/clean.ts && bun --bun vite build && bun scripts/prepare-static.ts && bun scripts/llms-text.ts",
    "preview": "bun scripts/preview.ts",
    "deploy:check": "bun --bun wrangler deploy --dry-run",
    "type-check": "tsc -p tsconfig.json",
    "og": "bun scripts/og/generate.ts",
    "og:fonts": "bun scripts/og/fonts.ts",
    "test": "bun scripts/check-static.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.18.4",
    "lucide-react": "1.67.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@goodnight-web/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7",
    "wrangler": "4.160.0"
  }
}
