---
/** The title area at the top of a page. */
interface Props {
  /** A short label above the title, such as `About` on a Japanese page. */
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div
  class='relative overflow-hidden border-b border-border/70 bg-linear-to-b from-primary-soft to-background'
>
  <div
    aria-hidden='true'
    class='pointer-events-none absolute -top-24 right-[-6rem] size-80 rounded-full bg-primary/10 blur-3xl'
  >
  </div>
  <div class='relative mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20'>
    {
      eyebrow && (
        <p class='mb-3 text-sm font-bold tracking-wider text-primary-strong'>
          {eyebrow}
        </p>
      )
    }
    <h1 class='text-3xl font-bold sm:text-4xl'>{title}</h1>
    {lead && <p class='mt-4 max-w-2xl text-base text-muted sm:text-lg'>{lead}</p>}
    <slot />
  </div>
</div>
