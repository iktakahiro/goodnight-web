---
import PageHeader from '../../../components/site/page-header.astro';
import PostList from '../../../features/posts/post-list.astro';
import { postFeedPath } from '../../../features/posts/post-feed';
import { getPosts } from '../../../features/posts/posts';
import BaseLayout from '../../../layouts/base-layout.astro';
import { ui } from '../../../i18n/ui';
import { localeFromParam, localeStaticPaths } from '../../../i18n/locales';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromParam(Astro.params.lang);
const feedHref = postFeedPath(locale, 'blog');
const posts = await getPosts('blog', locale);

const text = {
  ja: {
    eyebrow: 'Blog',
    title: 'ブログ',
    lead: '家具の手入れや選び方など、工房の仕事で得た知識をまとめています。',
  },
  en: {
    eyebrow: 'Blog',
    title: 'Blog',
    lead: 'Notes from our workshop on caring for and choosing furniture.',
  },
}[locale];
---

<BaseLayout locale={locale} title={text.title} description={text.lead} path='/blog/' feed='blog'>
  <PageHeader eyebrow={text.eyebrow} title={text.title} lead={text.lead} />
  <div class='mx-auto max-w-4xl px-5 pt-12 sm:px-8'>
    <p class='mb-4 text-right text-sm'>
      <a href={feedHref} class='font-bold text-primary-strong'>{ui.rssFeed[locale]}</a>
    </p>
    <PostList locale={locale} collection='blog' posts={posts} />
  </div>
</BaseLayout>
