---
/** The detail page of one news or blog post. */
import { render } from 'astro:content';
import Badge from '../../components/ui/badge.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { formatDate, localizePath } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import { parsePostId, type Post, type PostCollection } from './posts';
import type { Locale } from '../../../site.config';

interface Props {
  collection: PostCollection;
  post: Post;
  locale: Locale;
  slug: string;
  /** Languages that have a post with the same slug. */
  locales: Locale[];
  neighbors: { newer?: Post; older?: Post };
}

const { collection, post, locale, slug, locales, neighbors } = Astro.props;
const { Content } = await render(post);
const path = `/${collection}/${slug}/`;
const listPath = `/${collection}/`;
const alternates = Object.fromEntries(
  locales.map((l) => [l, path] as const),
) as Partial<Record<Locale, string>>;
const backLabel = collection === 'news' ? ui.backToNews : ui.backToBlog;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  path={path}
  alternates={alternates}
  ogType='article'
  publishedTime={post.data.date}
>
  <article class='mx-auto max-w-3xl px-5 pt-12 sm:px-8 sm:pt-16'>
    <a
      href={localizePath(locale, listPath)}
      class='inline-flex items-center gap-1 text-sm font-bold text-primary-strong no-underline hover:underline'
    >
      <span aria-hidden='true'>←</span>
      {backLabel[locale]}
    </a>
    <header class='mt-6 space-y-4 border-b border-border pb-8'>
      <h1 class='text-2xl font-bold sm:text-3xl'>{post.data.title}</h1>
      <p class='flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted'>
        <span>
          {ui.published[locale]}:
          <time datetime={isoDate(post.data.date)}>
            {formatDate(locale, post.data.date)}
          </time>
        </span>
        {
          post.data.updated && (
            <span>
              {ui.updated[locale]}:
              <time datetime={isoDate(post.data.updated)}>
                {formatDate(locale, post.data.updated)}
              </time>
            </span>
          )
        }
      </p>
      {
        post.data.tags.length > 0 && (
          <p class='flex flex-wrap gap-1.5'>
            {post.data.tags.map((tag) => (
              <Badge>{tag}</Badge>
            ))}
          </p>
        )
      }
    </header>
    <div class='prose-content mt-8'>
      <Content />
    </div>
    {
      (neighbors.newer || neighbors.older) && (
        <nav aria-label={ui.postNavigation[locale]} class='mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2'>
          {(['newer', 'older'] as const).map((direction) => {
            const neighbor = neighbors[direction];
            return neighbor && (
              <a
                href={localizePath(locale, `/${collection}/${parsePostId(neighbor.id).slug}/`)}
                class:list={[
                  'min-w-0 min-h-11 rounded-card border border-border bg-card p-5 no-underline transition-colors hover:bg-primary-softer',
                  direction === 'older' && 'sm:col-start-2 sm:text-right',
                ]}
              >
                <span class='block text-sm font-bold text-primary-strong'>
                  {direction === 'newer' && <span aria-hidden='true'>← </span>}
                  {direction === 'newer' ? ui.newerPost[locale] : ui.olderPost[locale]}
                  {direction === 'older' && <span aria-hidden='true'> →</span>}
                </span>
                <span class='mt-1 block leading-relaxed font-bold break-words'>{neighbor.data.title}</span>
              </a>
            );
          })}
        </nav>
      )
    }
  </article>
</BaseLayout>
