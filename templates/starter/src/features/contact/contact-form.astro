---
/**
 * The contact form. The fields come from the admin screen (Form page), not
 * from this file: the browser script reads them from the Worker
 * (`GET /api/contact/form`) and renders them into `[data-contact-fields]`.
 * While it loads, a skeleton is shown. When the form is not available (for
 * example, Turnstile is not set up yet), or it cannot be loaded, the script
 * shows a notice with the email address and phone number instead.
 *
 * The email field, the privacy consent, the hidden honeypot, and the
 * Turnstile widget are fixed. Keep the `data-*` attributes: the script reads
 * them. You may change the texts below, the layout, and the styles.
 */
import { localizePath } from '../../i18n/locales';
import { siteConfig, type Locale } from '../../../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const text = {
  ja: {
    required: '必須',
    optional: '任意',
    email: 'メールアドレス',
    emailHint: 'ご返信はこのアドレスにお送りします。',
    selectPlaceholder: '選択してください',
    loading: 'フォームを読み込んでいます…',
    noscript:
      'このフォームを使うには JavaScript を有効にしてください。メールまたはお電話でもご連絡いただけます。',
    consentBefore: '',
    consentLink: 'プライバシーポリシー',
    consentAfter: 'に同意します',
    honeypot: 'このフィールドは空のままにしてください',
    submit: '送信する',
    sending: '送信しています…',
    unavailableTitle: 'お問い合わせフォームは準備中です',
    unavailableBody:
      '現在、このフォームからはお問い合わせを受け付けていません。恐れ入りますが、メールまたはお電話でご連絡ください。',
    failedTitle: 'フォームを読み込めませんでした',
    failedBody:
      '通信のエラーでお問い合わせフォームを表示できませんでした。ページを再読み込みしてお試しいただくか、メールまたはお電話でご連絡ください。',
    reload: 'ページを再読み込み',
    success:
      'お問い合わせを受け付けました。内容を確認のうえ、担当者よりご連絡します。',
    invalid: '赤く表示された項目をご確認のうえ、もう一度送信してください。',
    outdated:
      '入力中にフォームの項目が更新されました。入力内容は残しています。項目をご確認のうえ、もう一度「送信する」を押してください。',
    verify:
      '送信ボタンの上にある確認（Turnstile）が終わるまでお待ちください。終わったら、もう一度「送信する」を押してください。',
    turnstile:
      '確認（Turnstile）を完了できませんでした。確認が終わるまでお待ちいただき、もう一度「送信する」を押してください。',
    fieldRequired: 'この項目は必須です。',
    fieldInvalid: '入力内容を確認してください。',
    fieldTooLong: '文字数が上限を超えています。',
    rateLimited:
      '短い時間に送信が続いたため、一時的に受け付けを制限しています。しばらく待ってからもう一度お試しください。',
    error:
      'エラーのため送信できませんでした。時間をおいてもう一度お試しいただくか、メールまたはお電話でご連絡ください。',
    contactEmail: 'メール',
    contactPhone: '電話',
  },
  en: {
    required: 'Required',
    optional: 'Optional',
    email: 'Email',
    emailHint: 'We will reply to this address.',
    selectPlaceholder: 'Select one',
    loading: 'Loading the form…',
    noscript:
      'This form needs JavaScript. You can also contact us by email or phone.',
    consentBefore: 'I agree to the ',
    consentLink: 'privacy policy',
    consentAfter: '',
    honeypot: 'Leave this field empty',
    submit: 'Send',
    sending: 'Sending…',
    unavailableTitle: 'The contact form is not available yet',
    unavailableBody:
      'This form is not accepting inquiries at the moment. Please contact us by email or phone instead.',
    failedTitle: 'The form could not be loaded',
    failedBody:
      'A connection error kept the contact form from loading. Reload the page to try again, or contact us by email or phone.',
    reload: 'Reload the page',
    success:
      'Thank you. We have received your inquiry and will get back to you.',
    invalid: 'Please check the fields marked in red, then send again.',
    outdated:
      'The form was updated while you were filling it in. What you typed is still there. Please check the fields, then press "Send" again.',
    verify:
      'Please wait until the check (Turnstile) above the Send button is complete, then press "Send" again.',
    turnstile:
      'The check (Turnstile) could not be completed. Please wait until the check is complete, then press "Send" again.',
    fieldRequired: 'This field is required.',
    fieldInvalid: 'Please check this field.',
    fieldTooLong: 'This is over the character limit.',
    rateLimited:
      'Too many messages were sent in a short time. Please wait a while and try again.',
    error:
      'Your message could not be sent because of an error. Please try again later, or contact us by email or phone.',
    contactEmail: 'Email',
    contactPhone: 'Phone',
  },
}[locale];

const { company } = siteConfig;

// Texts the browser script needs to render the fields and the errors.
const scriptTexts = {
  required: text.required,
  optional: text.optional,
  selectPlaceholder: text.selectPlaceholder,
  emailLabel: text.email,
  emailHint: text.emailHint,
  emailPlaceholder: 'name@example.com',
  fieldRequired: text.fieldRequired,
  fieldInvalid: text.fieldInvalid,
  fieldTooLong: text.fieldTooLong,
};

const notices = [
  {
    name: 'unavailable',
    title: text.unavailableTitle,
    body: text.unavailableBody,
    reload: false,
  },
  {
    name: 'failed',
    title: text.failedTitle,
    body: text.failedBody,
    reload: true,
  },
] as const;
---

<div data-contact data-locale={locale}>
  <script
    type='application/json'
    data-contact-texts
    set:html={JSON.stringify(scriptTexts).replace(/</g, '\\u003c')}
  />

  <div data-contact-loading aria-busy='true'>
    <p class='sr-only' role='status'>{text.loading}</p>
    <div class='animate-pulse space-y-7' aria-hidden='true'>
      {
        [0, 1, 2].map(() => (
          <div class='space-y-2'>
            <div class='h-4 w-32 rounded-full bg-primary-ring/40' />
            <div class='h-12 rounded-xl bg-primary-soft' />
          </div>
        ))
      }
      <div class='space-y-2'>
        <div class='h-4 w-40 rounded-full bg-primary-ring/40' />
        <div class='h-40 rounded-xl bg-primary-soft' />
      </div>
      <div class='h-13 w-40 rounded-full bg-primary-ring/40'></div>
    </div>
  </div>
  <noscript>
    <p class='rounded-xl bg-primary-softer p-4 font-bold'>{text.noscript}</p>
  </noscript>

  {
    notices.map((notice) => (
      <div
        data-contact-notice={notice.name}
        role='status'
        tabindex='-1'
        class='rounded-card border border-primary-ring/50 bg-primary-softer p-6 outline-none sm:p-8'
        hidden
      >
        <h2 class='text-lg font-bold'>{notice.title}</h2>
        <p class='mt-2 text-muted'>{notice.body}</p>
        <dl class='mt-4 grid gap-1 text-sm sm:grid-cols-[auto_1fr] sm:gap-x-4'>
          <dt class='font-bold'>{text.contactEmail}</dt>
          <dd>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </dd>
          {company.phone && (
            <>
              <dt class='font-bold'>{text.contactPhone}</dt>
              <dd>
                <a href={`tel:${company.phone}`}>{company.phone}</a>
              </dd>
            </>
          )}
        </dl>
        {notice.reload && (
          <button
            type='button'
            data-contact-reload
            class='mt-5 inline-flex min-h-11 items-center justify-center rounded-full border border-primary-ring bg-card px-6 text-sm font-bold text-primary-strong transition-colors hover:bg-primary-soft'
          >
            {text.reload}
          </button>
        )}
      </div>
    ))
  }

  <div
    data-contact-sent
    role='status'
    tabindex='-1'
    class='rounded-card bg-success-soft p-6 font-bold text-success outline-none sm:p-8'
    hidden
  >
    {text.success}
  </div>

  <form data-contact-form novalidate class='space-y-6' hidden>
    {/* The script renders the email field and the form's fields here. */}
    <div data-contact-fields class='space-y-6'></div>

    {/* Honeypot: hidden from people, filled in by some bots. */}
    <div
      class='absolute -left-[9999px] h-px w-px overflow-hidden'
      aria-hidden='true'
    >
      <label for='contact-website'>{text.honeypot}</label>
      <input
        id='contact-website'
        data-contact-honeypot
        type='text'
        tabindex='-1'
        autocomplete='off'
      />
    </div>

    <div class='space-y-2'>
      <div class='rounded-xl bg-primary-softer p-4'>
        <label class='flex items-start gap-3 font-bold'>
          <input
            id='contact-consent'
            name='consent'
            type='checkbox'
            value='yes'
            required
            class='mt-1.5 size-5 shrink-0 accent-primary'
          />
          <span>
            {text.consentBefore}
            <a
              href={localizePath(locale, '/privacy/')}
              target='_blank'
              class='text-primary-strong underline'
            >
              {text.consentLink}
            </a>
            {text.consentAfter}
            <span
              class='ml-2 inline-block rounded-full bg-primary px-2 py-px align-middle text-[0.7rem] text-primary-foreground'
            >
              {text.required}
            </span>
          </span>
        </label>
      </div>
      <p
        id='contact-consent-error'
        class='text-sm font-bold text-danger'
        hidden
      >
      </p>
    </div>

    {/* The script renders the Turnstile widget here. */}
    <div data-turnstile class='min-h-[65px]'></div>

    <div class='space-y-4'>
      {
        (
          [
            ['invalid', text.invalid],
            ['outdated', text.outdated],
            ['verify', text.verify],
            ['turnstile', text.turnstile],
            ['rate-limited', text.rateLimited],
            ['error', text.error],
          ] as const
        ).map(([status, message]) => (
          <p
            data-result={status}
            role='alert'
            tabindex='-1'
            hidden
            class='rounded-xl bg-danger-soft p-4 font-bold text-danger'
          >
            {message}
          </p>
        ))
      }

      <button
        type='submit'
        class='inline-flex min-h-13 w-full items-center justify-center rounded-full bg-primary px-10 font-bold text-primary-foreground shadow-sm shadow-primary/20 transition-colors hover:bg-primary-strong disabled:opacity-60 sm:w-auto'
        data-label-sending={text.sending}
      >
        {text.submit}
      </button>
    </div>
  </form>
</div>

<script>
  import { setupContactForm } from './contact-form-client';

  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) void setupContactForm(root);
</script>
