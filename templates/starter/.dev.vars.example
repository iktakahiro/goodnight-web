# Secrets for this site. Never commit real values.
#
# - Deploy to Cloudflare button: the setup form asks for each value below that
#   is not commented out.
# - Production: set them in the Cloudflare dashboard (Workers & Pages > your
#   Worker > Settings > Variables and Secrets) or with `npx wrangler secret put
#   <NAME>`.
# - Local development: copy this file to .dev.vars and fill it in. `wrangler
#   dev` reads .dev.vars. Git ignores it.
#
# A feature whose secret is missing is turned off: for example, the contact
# form does not accept messages until TURNSTILE_SECRET and the public
# TURNSTILE_SITE_KEY (in wrangler.jsonc) are set. APP_SECRET must be a random
# value of at least 32 characters. Nothing generates it for you, not even the
# Deploy button form: use `openssl rand -base64 32`. A shorter value, or one
# that is clearly not random (such as one character repeated), turns sign-in
# and the contact form off in the same way, and the admin screen says which
# value to replace.
#
# The admin screen, setup, sign-in, and the contact API work only over
# https://, except on localhost and 127.0.0.1 for `wrangler dev`.

# One random string of 32 characters or more. You enter it once at /admin to
# create the first admin. The key that signs admin sessions and the key for IP
# address hashes are derived from it.
# Do not delete or change it after setup: deleting it turns sign-in and the
# contact form off, and changing it signs every admin out and changes IP
# hashes. Keep a copy in a password manager.
# Create one with: openssl rand -base64 32
APP_SECRET=

# Email addresses that may become admins, separated by commas.
# Example: you@example.com,colleague@example.com
ADMIN_EMAILS=

# The Turnstile secret key (Cloudflare dashboard > Turnstile). It pairs with
# TURNSTILE_SITE_KEY in wrangler.jsonc.
TURNSTILE_SECRET=

# Optional. A Slack incoming webhook URL (https://hooks.slack.com/...). Slack
# gets "1 new inquiry", the received time, and a link to the admin screen;
# never the name, email address, or anything typed in the form. Leave it
# empty for no notifications.
SLACK_WEBHOOK_URL=

# Optional. Cloudflare Access in front of /admin, /api/admin, /api/setup, and
# /api/auth. With both set, the Worker also checks the Access token
# (Cf-Access-Jwt-Assertion) on those paths. Set both or neither; with only one
# set, those paths answer 503. ACCESS_AUD is the application's "Application
# Audience (AUD) Tag"; ACCESS_TEAM_DOMAIN looks like
# your-team.cloudflareaccess.com.
# ACCESS_AUD=
# ACCESS_TEAM_DOMAIN=

# Optional. Separate values instead of the ones APP_SECRET gives. A value set
# here wins over APP_SECRET for its purpose. SETUP_TOKEN: the only value setup
# accepts; you may delete it after setup. BETTER_AUTH_SECRET: signs admin
# sessions. IP_HASH_SECRET: the key for IP address hashes. Each is a random
# string of 32 characters or more. A site that already sets these three
# keeps working as before. The Deploy to Cloudflare form does not ask for
# them; set them in the dashboard or with `npx wrangler secret put`.
# SETUP_TOKEN=
# BETTER_AUTH_SECRET=
# IP_HASH_SECRET=
