// Cloudflare Workers settings for this site.
//
// Do not rename the bindings (DB, CONTACT_RATE_LIMITER, ASSETS) and do not
// remove the run_worker_first paths: @goodnight-web/server looks them up by
// name, and the contact form and the admin screen stop working without them.
// Secrets (APP_SECRET, ADMIN_EMAILS, and so on) are not set here. See
// .dev.vars.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodnight-web-starter",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev address. A new site has no custom domain yet, so this is
  // the only way to reach /admin for the first setup; keep it true until
  // then. After you attach your own domain (and before you register the
  // first passkey), set it to false here and commit. Do not use the
  // dashboard toggle instead: `wrangler deploy` applies this file on every
  // deploy, and without routes it turns workers.dev back on.
  "workers_dev": true,
  // Preview URLs give every uploaded version its own public address, and
  // each version uses the production D1 database and secrets. They are off,
  // so an unmerged pull request never gets a public address. Cloudflare
  // otherwise turns them on whenever workers_dev is on. Turn them on only if
  // you accept that.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The contact API and the admin screen run in the Worker. Every other
    // path is a page from ./dist.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodnight-web-starter",
      // The database migrations ship inside @goodnight-web/server. Do not run
      // `wrangler d1 migrations create`.
      "migrations_dir": "node_modules/@goodnight-web/server/migrations",
    },
  ],
  "ratelimits": [
    {
      // Limits contact form submissions, setup attempts, and passkey sign-ins
      // per visitor. Other Workers in the same Cloudflare account that use
      // the same namespace_id share the counter.
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    // The public Turnstile site key. The contact form reads it from the
    // Worker, so this is the only place to set it. While it is empty, the
    // contact form says that it is not available yet.
    "TURNSTILE_SITE_KEY": "",
  },
}
